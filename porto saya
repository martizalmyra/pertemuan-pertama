    <!-- ==================== JAVASCRIPT SIMPEL ==================== -->
    <script>
        // Logika untuk menampilkan & menyembunyikan Menu di HP
        const btnMenu = document.getElementById('btn-menu');
        const menuHp = document.getElementById('menu-hp');
        const linkHp = document.querySelectorAll('.link-hp');
        const ikonMenu = btnMenu.querySelector('i');

        // Buka/tutup menu ketika tombol hamburger ditekan
        btnMenu.addEventListener('click', () => {
            menuHp.classList.toggle('hidden');
            if (menuHp.classList.contains('hidden')) {
                ikonMenu.classList.remove('ph-x');
                ikonMenu.classList.add('ph-list');
            } else {
                ikonMenu.classList.remove('ph-list');
                ikonMenu.classList.add('ph-x');
            }
        });

        // Tutup menu otomatis jika salah satu menu di HP diklik
        linkHp.forEach(link => {
            link.addEventListener('click', () => {
                menuHp.classList.add('hidden');
                ikonMenu.classList.remove('ph-x');
                ikonMenu.classList.add('ph-list');
            });
        });
    </script>
